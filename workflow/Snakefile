configfile: "workflow/config/defaults.yaml"

wildcard_constraints:
    path = "<simulation>|<pseudosimulation>|<outputs_assignment>"

from workflow.helpers.build_subgrids import auto_create_grid

config = auto_create_grid(config)

NUM_GRID_POINTS = int(config["grid"]["N_rotations"])
if config["grid"]["translation_algorithm"]=="spherical":
    N_directions = int(config["grid"]["translation_subgrids_A"][0])
    N_radial = int(config["grid"]["translation_subgrids_A"][1][-1])
    NUM_GRID_POINTS = NUM_GRID_POINTS * N_directions * N_radial
elif config["grid"]["translation_algorithm"]=="cartesian":
    N_x = int(config["grid"]["translation_subgrids_A"][0][-1])
    N_y = int(config["grid"]["translation_subgrids_A"][1][-1])
    N_z = int(config["grid"]["translation_subgrids_A"][2][-1])
    NUM_GRID_POINTS = NUM_GRID_POINTS * N_x * N_y * N_z
else:
    raise ValueError("Cannot calculate total number of grid points.")


pathvars:
    # general terms, not complete paths
    molecule1 = config["pseudotrajectory"]["molecule_1"],
    molecule2 = config["pseudotrajectory"]["molecule_2"],
